# ==============================================================================
# WORKVORTEX — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. Server Runtime Port
PORT=3001

# 2. Server-Side Authentication & Session Security (Set a strong 32+ character random secret)
AUTH_SECRET=workvortex-secure-auth-secret-production-2026-replace-me
JWT_SECRET=workvortex-secure-jwt-production-secret-2026-replace-me

# 3. Google OAuth 2.0 / OpenID Connect (Server-Side Only)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: https://yourdomain.com/api/auth/google/callback (or http://localhost:3001/api/auth/google/callback)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# 4. Public Canonical Website & Server URLs
PUBLIC_SITE_URL=http://localhost:5173
VITE_SITE_URL=http://localhost:5173

# 5. Studio Email Notifications & Dispatch
STUDIO_EMAIL=workvortex01@gmail.com
# Optional SMTP configuration for live outbound emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 6. Server-Side AI Lead Qualification (Never expose to frontend client code)
# If empty, WORKVORTEX operates with the built-in high-precision semantic heuristic engine
OPENAI_API_KEY=
